{
  "name": "lingsheng-core-xf",
  "version": "0.1.0",
  "private": true,
  "description": "菱声 LS20/LS22 音柱控制核心服务（讯飞离线 TTS 版）",
  "license": "MIT",
  "author": "PetrelCode",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "capture": "node tools/capture.mjs",
    "tts:setup": "node tools/setup-xf.mjs",
    "tts:build": "make -C native",
    "tts:check": "make -C native check",
    "pack:offline": "node deploy/build-offline.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "aedes": "^0.51.3",
    "lamejs": "^1.2.1",
    "mqtt": "^5.10.1",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
